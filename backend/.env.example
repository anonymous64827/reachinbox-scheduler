PORT=5000
NODE_ENV=development

# Database configuration
DATABASE_URL="file:./dev.db"
# For PostgreSQL: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public"

# Redis configuration (Used by BullMQ and Rate Limiting)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# BullMQ Worker Configuration
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_SECONDS=2
DEFAULT_HOURLY_LIMIT=50

# Ethereal Email SMTP (Leave empty to auto-generate free credentials at runtime)
ETHEREAL_USER=
ETHEREAL_PASS=

# Elasticsearch Configuration (Optional, falls back to DB search if offline)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# Google OAuth (For Google Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=reachinbox_super_secret_jwt_key_2026

# Slack Integration (OAuth or Webhook)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/oauth/callback
SLACK_DEFAULT_WEBHOOK=

# Frontend URL
FRONTEND_URL=http://localhost:3000
